DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical hostname: force www to non-www.
  RewriteCond %{HTTP_HOST} ^www\.asbestosremovalsinlondon\.co\.uk$ [NC]
  RewriteRule ^ https://asbestosremovalsinlondon.co.uk%{REQUEST_URI} [R=301,L,NE]

  # Legacy homepage URL seen in Search Console.
  RewriteRule ^home\.html$ / [R=301,L,NE]

  # Legacy malformed disposal URL replaced with a clean canonical service URL.
  RewriteRule ^asbestos8203-8203disposal8203-8203in8203-8203london\.html$ /asbestos-disposal-london.html [R=301,L,NE]

  # Legacy malformed roof-removal URL seen in Search Console.
  RewriteRule ^asbestos8203-roof-removal8203-8203london\.html$ /asbestos-roof-removal-london.html [R=301,L,NE]
</IfModule>

Redirect 301 /london-borough-of-sutton-asbestos-removal.html /asbestos-removal-sutton-london.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
