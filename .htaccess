DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.asbestosremovalsinlondon\.co\.uk$ [NC]
  RewriteRule ^ https://asbestosremovalsinlondon.co.uk%{REQUEST_URI} [R=301,L,NE]
</IfModule>

Redirect 301 /home.html /
Redirect 301 /london-borough-of-sutton-asbestos-removal.html /asbestos-removal-sutton-london.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
